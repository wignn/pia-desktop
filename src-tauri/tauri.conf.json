{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pia",
  "version": "3.0.21",
  "identifier": "dev.wign.pia",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PIA Terminal",
        "width": 380,
        "height": 415,
        "minWidth": 360,
        "minHeight": 380,
        "decorations": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; worker-src 'self' blob:; child-src 'self' blob: https://www.youtube.com https://www.youtube-nocookie.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' tauri: ipc: data: blob: https: wss: http://ipc.localhost http://tauri.localhost http://localhost:* ws://localhost:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFENEUzMTUzNjYzM0I2Q0QKUldUTnRqTm1VekZPclVZdGR5am4rbVByQkNGKzhsMG5RdDNSUXlGMkZyMk5LVk9ESHBJbExjbHEK",
      "endpoints": [
        "https://github.com/wignn/pia-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
