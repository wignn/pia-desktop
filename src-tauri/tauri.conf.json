{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pia",
  "version": "2.0.1",
  "identifier": "dev.wign.pia",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PIA Terminal",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFENEUzMTUzNjYzM0I2Q0QKUldUTnRqTm1VekZPclVZdGR5am4rbVByQkNGKzhsMG5RdDNSUXlGMkZyMk5LVk9ESHBJbExjbHEK",
      "endpoints": [
        "https://github.com/wignn/pia-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
