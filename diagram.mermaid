flowchart TD

subgraph group_foundation["Platform contracts"]
  node_contracts["Versioned contracts<br/>Rust shared crate<br/>[event_envelope.rs]"]
  node_domain["Tenant domain<br/>Rust shared crate<br/>[tenant.rs]"]
  node_auth["API-key auth<br/>Rust shared crate<br/>[api_key.rs]"]
end

subgraph group_pipeline["Ingestion &amp; processing"]
  node_ingestion["Ingestion gateway<br/>Rust service<br/>[main.rs]"]
  node_macro["Macro collector<br/>Go service<br/>[main.go]"]
  node_rss["RSSHub connector<br/>Python worker<br/>[run_worker.py]"]
  node_market["Market data<br/>Rust service<br/>[ingestion.rs]"]
  node_news["News service<br/>Rust service<br/>[pipeline.rs]"]
  node_intelligence["Intelligence service<br/>Rust service<br/>[why_move.rs]"]
  node_analyzer["Python analyzer<br/>Model worker<br/>[main.py]"]
  node_sink["Sink connector<br/>Rust consumer<br/>[macro_worker.rs]"]
end

subgraph group_access["Access &amp; delivery"]
  node_api["API gateway<br/>Rust ingress<br/>[main.rs]"]
  node_control["Control plane<br/>Rust SaaS service<br/>[server.rs]"]
  node_realtime["Realtime gateway<br/>Rust WebSocket service<br/>[hub.rs]"]
  node_clients["Web, admin, terminal &amp; bot<br/>Client surfaces<br/>[+page.svelte]"]
end

subgraph group_data["Data &amp; operations"]
  node_deploy{{"Blue/green deployment<br/>Compose deployment"}}
  node_nats["NATS JetStream<br/>Durable event bus<br/>[nats.rs]"]
  node_postgres[("PostgreSQL<br/>Transactional store")]
  node_clickhouse[("ClickHouse<br/>Analytics store")]
  node_redis[("Redis<br/>Hot-state store")]
  node_monitoring["Observability stack<br/>Prometheus/Grafana/Loki<br/>[monitoring.yml]"]
end

node_deploy -->|"runs"| node_api
node_deploy -->|"runs"| node_market
node_deploy -->|"runs"| node_realtime
node_contracts -->|"defines envelopes/topics"| node_nats
node_domain -->|"models tenancy"| node_control
node_auth -->|"validates keys"| node_api
node_ingestion -->|"publishes normalized feeds"| node_nats
node_macro -->|"publishes macro events"| node_nats
node_rss -->|"publishes normalized content"| node_nats
node_nats -->|"market events"| node_market
node_nats -->|"news and macro events"| node_news
node_nats -->|"durable consumption"| node_sink
node_market -->|"writes ticks/OHLCV"| node_clickhouse
node_market -->|"writes latest state"| node_postgres
node_sink -->|"materializes events"| node_postgres
node_news -->|"enriched workflows"| node_intelligence
node_intelligence -->|"delegates model work"| node_analyzer
node_control -->|"tenant authority"| node_postgres
node_control -->|"syncs entitlements"| node_redis
node_api -->|"checks quotas"| node_redis
node_api -->|"proxies market APIs"| node_market
node_api -->|"proxies news APIs"| node_news
node_realtime -->|"subscribes updates"| node_nats
node_realtime -->|"tickets and hot state"| node_redis
node_clients -->|"REST"| node_api
node_clients -->|"WebSocket"| node_realtime
node_monitoring -.->|"health gates"| node_deploy

